#!/usr/bin/env bash
# 커밋 메시지 규격 강제.
#
# 규격의 출처는 `AGENTS.md`의 「커밋 규칙」이고, 그 규칙은 mes-solution-core·
# mes-solution-standard가 문서로만 지켜 오던 것을 그대로 옮겨 온 것이다. 저 두 저장소는
# 검사를 사람에게 맡겼고, 그래서 자기 규칙을 어긴 커밋이 실제로 남았다. 이 저장소는 같은
# 규칙을 기계가 판정한다.
#
# 설치: `npm run hooks:install`(= git config core.hooksPath .githooks). `npm install`의
# `prepare`가 같은 일을 하므로 새로 받은 사람도 따로 기억할 것이 없다.
#
# 이 훅은 메시지의 **모양**만 본다. 내용이 옳은지, 변경과 맞는지는 판정하지 않는다.
set -euo pipefail

# 한국어 어미·문장부호를 글자 단위로 보려면 UTF-8 locale이어야 한다. 시스템 locale이
# 무엇이든 판정이 같아야 하므로 여기에서 고정한다.
export LC_ALL="${LC_ALL:-en_US.UTF-8}"
export LANG="${LANG:-en_US.UTF-8}"

MESSAGE_FILE="$1"
GIT_DIR_PATH="$(git rev-parse --git-dir)"

# 허용 type. core AGENTS.md의 목록 그대로다.
TYPES="feat|fix|test|docs|refactor|chore|merge|ops|db|release"

errors=()
fail() { errors+=("$1"); }

# 주석(`#`)과 `git commit --verbose`가 붙이는 diff 이후는 메시지가 아니다.
#
# `mapfile`을 쓰지 않는다. macOS가 기본으로 싣는 bash는 3.2이고 그 자리에는 없는 명령이다.
# 훅이 사람의 기본 shell에서 돌지 않으면 검사 자체가 없는 것과 같다.
lines=()
while IFS= read -r line || [ -n "${line}" ]; do
  lines+=("${line}")
done < <(
  sed -e '/^# ------------------------ >8 ------------------------$/,$d' \
      -e '/^#/d' "${MESSAGE_FILE}"
)

# 뒤쪽 빈 줄을 걷어낸다. bash 3.2에는 음수 첨자가 없으므로 길이로 마지막 자리를 센다.
while [ ${#lines[@]} -gt 0 ]; do
  last_index=$((${#lines[@]} - 1))
  [ -n "${lines[${last_index}]//[[:space:]]/}" ] && break
  unset "lines[${last_index}]"
done

if [ ${#lines[@]} -eq 0 ]; then
  printf 'error: 커밋 메시지가 비어 있습니다.\n' >&2
  exit 1
fi

title="${lines[0]}"

# 1. 제목 형식 --------------------------------------------------------------
case "${title}" in
  "fixup!"*|"squash!"*|"amend!"*)
    fail "'fixup!'·'squash!'·'amend!' 메시지는 쓰지 않습니다. 규격에 맞게 다시 씁니다." ;;
esac
case "${title}" in
  "Merge "*|"Revert "*)
    fail "Git 기본 'Merge …'·'Revert …' 제목은 쓰지 않습니다. '<type>(<scope>): <목적>' 형식으로 다시 씁니다." ;;
esac

if ! [[ "${title}" =~ ^(${TYPES})(\([a-z0-9][a-z0-9._/-]*\))?:\ .+$ ]]; then
  fail "제목 형식이 '<type>(<선택 scope>): <목적>'이 아닙니다.
        허용 type: ${TYPES//|/, }
        scope는 소문자·숫자로 시작하고 그다음은 소문자·숫자·. _ / - 만 씁니다.
        받은 제목: ${title}"
fi

if [ "${#title}" -gt 100 ]; then
  fail "제목이 100자를 넘습니다(${#title}자). 목적 한 줄로 줄입니다."
fi

# 2. 제목과 본문 사이 빈 줄 --------------------------------------------------
if [ ${#lines[@]} -lt 2 ]; then
  fail "본문이 없습니다. 주요 변경을 '- '로 시작하는 줄 2개 이상으로 적습니다."
elif [ -n "${lines[1]//[[:space:]]/}" ]; then
  fail "제목 다음 줄은 비어 있어야 합니다."
fi

# 3. 본문 -------------------------------------------------------------------
# bash 3.2에서 `set -u`와 빈 배열 전개는 함께 서지 못한다. `${arr[@]}`가 비어 있으면
# "unbound variable"로 죽으므로, 본문이 없는 메시지에서 판정 대신 shell 오류가 나온다.
# 막기는 하지만 사람에게 이유를 주지 못하므로 거절이 아니라 고장이다. 길이를 먼저 본다.
body=()
if [ ${#lines[@]} -gt 2 ]; then
  body=("${lines[@]:2}")
fi
bullets=0
for line in ${body[@]+"${body[@]}"}; do
  [ -z "${line//[[:space:]]/}" ] && continue
  case "${line}" in
    "- "*) bullets=$((bullets + 1)) ;;
    *) fail "본문의 모든 줄은 '- '로 시작해야 합니다. 받은 줄: ${line}" ;;
  esac
done

if [ "${bullets}" -lt 2 ]; then
  fail "본문 bullet이 ${bullets}개입니다. 주요 변경을 2개 이상 적습니다."
fi

# 상한은 막지 않고 알리기만 한다. core 문서의 권고는 2~4줄이지만, 실제 저장소의 커밋은
# 넷을 넘는 일이 잦고 그 커밋들이 잘못이라고 볼 근거가 없다. 막으면 사람이 변경을 감춘다.
if [ "${bullets}" -gt 4 ]; then
  printf 'note: 본문 bullet이 %d개입니다. 권고는 2~4개이며, 커밋을 가를 수 있는지 살펴보십시오.\n' "${bullets}" >&2
fi

# 4. 명사형 어미 -------------------------------------------------------------
# 제목과 각 bullet은 한국어 명사구로 적고 '다'나 종결 문장부호로 끝내지 않는다.
check_noun_phrase() {
  local text="$1" where="$2" trimmed
  trimmed="${text%"${text##*[![:space:]]}"}"
  if [[ "${trimmed}" =~ 다$ ]]; then
    fail "${where}이(가) '다'로 끝납니다. 명사구로 적습니다: ${trimmed}"
  fi
  if [[ "${trimmed}" =~ [.!?。！？]$ ]]; then
    fail "${where}이(가) 종결 문장부호로 끝납니다: ${trimmed}"
  fi
}

check_noun_phrase "${title#*: }" "제목"
for line in ${body[@]+"${body[@]}"}; do
  [ -z "${line//[[:space:]]/}" ] && continue
  case "${line}" in "- "*) check_noun_phrase "${line#- }" "본문 bullet" ;; esac
done

# 5. 금지 표식 ---------------------------------------------------------------
for line in "${lines[@]}"; do
  case "${line}" in
    *"Co-Authored-By"*|*"Co-authored-by"*) fail "'Co-Authored-By' 줄은 넣지 않습니다." ;;
    *"Signed-off-by"*) fail "'Signed-off-by' 줄은 넣지 않습니다." ;;
    *"Generated with"*|*"🤖"*) fail "생성 도구 표기는 넣지 않습니다." ;;
  esac
done

# 6. merge type과 실제 병합 --------------------------------------------------
# 'merge'는 부모가 둘 이상인 진짜 병합 커밋에만 쓴다. 병합 중인지는 MERGE_HEAD가 말한다.
if [[ "${title}" =~ ^merge ]] && [ ! -e "${GIT_DIR_PATH}/MERGE_HEAD" ]; then
  fail "'merge' type은 부모가 둘 이상인 실제 병합 커밋에만 씁니다."
fi

# 판정 ----------------------------------------------------------------------
if [ ${#errors[@]} -gt 0 ]; then
  printf '\n커밋 메시지가 규격에 맞지 않습니다 (%d건). 규격은 AGENTS.md 「커밋 규칙」입니다.\n\n' "${#errors[@]}" >&2
  for error in "${errors[@]}"; do
    printf '  ✗ %s\n' "${error}" >&2
  done
  printf '\n예시\n\n  feat(projects): 프로젝트 목록 화면과 상태 거르개\n\n  - taxonomy leaf에 붙는 프로젝트 목록 표와 상태·담당자 거르개\n  - 회사 범위 밖 행을 막는 RLS 정책과 그 회귀 시험\n\n' >&2
  exit 1
fi

exit 0
